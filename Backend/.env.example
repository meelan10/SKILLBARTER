# PostgreSQL connection string
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/skillbarter"

# Long random secret used to sign JWTs
JWT_SECRET="change_this_to_a_long_random_secret"

# How long a login token stays valid
JWT_EXPIRES_IN="7d"

PORT=5000

# Where the React frontend runs (used for CORS + Socket.IO)
CLIENT_URL="http://localhost:5173"

# How many minutes a session verification code stays valid
VERIFICATION_CODE_TTL_MINUTES=30
